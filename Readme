
table des parties:
game_id INTEGER PRIMARY KEY AUTOINCREMENT,
winner_id INTEGER NOT NULL,
loser_id INTEGER NOT NULL,
loser_score INTEGER NOT NULL,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP


tables des utilisateur:
	user_id INTEGER PRIMARY KEY AUTOINCREMENT,
	username TEXT NOT NULL,
	password TEXT NOT NULL,
    picture_path TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP


transcendance modules:
    - backend fastify (1)
    - db backend (0.5)
    - front TailwindCss (0.5)
    - standart user management (1)
    - Remote auth, Google Sign-in (1)
    - remote players (1)
    - 2FA (1)
    - Multiple browser, Brave (0.5)
    - Multiple language (0.5)
    - server-side pong, API endpoint (1)

    Donc 8


Exemple de cmd curl :

curl -H 'Content-Type: application/json' -kd '{ "title":"foo","body":"bar", "id": 1}' https://k2r2p1.42mulhouse.fr:3000/tournament/create