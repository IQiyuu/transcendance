<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="style.css" rel="stylesheet">

    <title>Trong</title>

</head>

<body class="min-h-screen p-3 sm:p-4 lg:p-6 flex items-center justify-center bg-gradient-to-br from-purple-600 to-blue-500 overflow-x-hidden">

    <select id="lang_select" class="fixed top-2 left-2 z-50">

        <option value="jp">🇯🇵 日本語</option>

        <option value="fr">🇫🇷 Français</option>

        <option value="en">🇺🇸 English</option>

    </select>

    <button id="logout_btn" class="hidden fixed top-2 right-2 z-50 cursor-pointer">Logout</button>    <!-- LOGIN FORM -->

    <div id="login-form" class="hidden flex-col p-6 items-center justify-center bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700 max-w-sm w-full">

        <h1 class="underline text-white text-4xl text-center mb-4" id="form-title">Connexion</h1>



        <form class="w-full" id="form">

            <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white" for="username">Username</label>

            <input class="mb-4 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" id="username" name="username" required />



            <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white" for="password">Password</label>

            <input class="mb-2 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" id="password" name="password" type="password" required />



            <p class="hidden text-red-600 mb-2" id="errorAuth"></p>



            <a class="font-medium text-blue-600 hover:underline dark:text-blue-500 block mb-2 text-right" id="register-view" href="#">S'inscrire</a>



            <button id="login_btn" class="w-full text-white bg-gradient-to-br from-green-400 to-blue-600 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-green-200 dark:focus:ring-green-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center" type="submit">Se connecter</button>

        </form>

    </div>



    <div id="site" class="hidden w-full max-w-7xl mx-auto min-w-0">

        <div id="pong-game">

            <div id="gameContainer">

                <h1 class="mb-5 sm:mb-8 text-center text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white cursor-pointer drop-shadow-lg" id="game_title">Trong the Game</h1>

                <!-- MENU -->

                <div id="pageContent" class="w-full">

                    <div id="menu" class="block mx-auto w-full max-w-3xl px-3 sm:px-6 lg:px-0">

                        <div class="flex flex-col gap-4 sm:gap-5">

                            <button id="offline" class="menu-btn bg-gradient-to-br from-fuchsia-500 to-purple-700 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Play local</button>

                            <button id="matchmaking" class="menu-btn bg-gradient-to-br from-emerald-500 to-teal-700 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Play online</button>

                            <button id="tournament_button" class="menu-btn bg-gradient-to-br from-sky-500 to-blue-700 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Tournament</button>

                            <button id="tournament_create_button" class="menu-btn hidden bg-gradient-to-br from-sky-500 to-blue-700 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Create</button>

                            <button id="tournament_join_button" class="menu-btn hidden bg-gradient-to-br from-sky-500 to-blue-700 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Join</button>

                            <button id="profile_button" class="menu-btn bg-gradient-to-br from-orange-400 to-rose-600 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">Profile</button>

                            <button id="about_button" class="menu-btn bg-gradient-to-br from-slate-500 to-slate-700 sm:col-span-2 min-h-20 sm:min-h-24 w-full text-xl sm:text-2xl lg:text-3xl">About</button>

                        </div>

                    </div>

            </div>



<!-- PROFILE -->

<div id="player_profile" class="hidden w-full max-w-6xl mx-auto justify-center flex-col items-center gap-6 lg:gap-8 rounded-2xl bg-black/20 p-3 sm:p-6 text-white backdrop-blur-md min-w-0">

    <div id="profile_layout" class="w-full flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-8">

        <!-- Carte de Profil -->

        <div id="profile_card" class="flex w-full max-w-md mx-auto min-w-0 flex-col items-center justify-center rounded-2xl border border-white/20 bg-white/10 p-5 sm:p-6 shadow-lg backdrop-blur-md">

            <!-- Image de profil -->

            <div class="relative w-28 h-28 sm:w-32 sm:h-32 mb-4 shrink-0">

                <img id="profile_picture" class="w-full h-full rounded-full shadow-lg object-cover" src="assets/imgs/standart.jpg"/>

                <img src="assets/imgs/hoverPicture.png" id="camera_icon" class="absolute inset-0 top-1/4 mx-auto w-1/2 h-1/2 opacity-0 cursor-pointer transition-all duration-200 hover:opacity-80" />

            </div>

            <!-- Overlay pour changement de photo -->

            <div id="profile_picture_overlay" class="fixed inset-0 items-center justify-center bg-black bg-opacity-0 hidden z-50">

                <form id="profil_picture_square" class="flex flex-col items-center bg-gray-800 p-6 rounded-lg shadow-lg relative max-w-[calc(100vw-2rem)]">

                    <p id="div_title" class="text-lg text-white mb-4 text-center">Upload your profile picture</p>

                    <button id="profile_cross" type="button" class="absolute top-2 right-2 text-white text-lg">✖</button>

                    <input type="file" id="file_input" class="mb-4 p-2 rounded-md bg-gray-700 text-white max-w-full" />

                    <button id="upload_btn" class="w-1/2 py-2 text-white bg-blue-600 rounded-md hover:bg-blue-700">Upload</button>

                    <img id="previsu_picture" src="" width="50" height="50" class="mt-4"/>

                </form>

            </div>

            <!-- Infos utilisateur -->

            <h5 class="mb-1 text-2xl font-semibold text-center break-words max-w-full" id="profile_username">Username</h5>

            <span id="wr_card" class="text-sm font-medium text-center">Winrate N/A</span>

            <!-- Boutons -->

            <div id="friend_div" class="flex flex-wrap justify-center mt-5 gap-2 sm:gap-3 w-full">

                <button id="friend_btn" class="px-4 sm:px-6 py-2 bg-gradient-to-r from-green-400 to-blue-600 text-white rounded-lg hover:bg-gradient-to-bl transition-all duration-300 text-sm sm:text-base">Add Friend</button>

                <button id="block_btn" class="px-4 sm:px-6 py-2 bg-gradient-to-r from-red-400 to-yellow-600 text-white rounded-lg hover:bg-gradient-to-bl transition-all duration-300 text-sm sm:text-base">Block</button>

                <button id="fa_btn" class="relative mt-2 sm:mt-0 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-600 px-4 sm:px-6 py-2 font-bold text-white shadow-lg transition duration-300 hover:shadow-xl text-sm sm:text-base"></button>

            </div>

            <!-- 2FA -->

            <div class="relative mt-5 w-full max-w-sm overflow-hidden rounded-lg bg-white/10 px-5 py-4 text-center">

                <span class="relative z-10">2FA</span>

                <span class="absolute inset-0 bg-white opacity-10 rounded-lg blur-sm"></span>

            </div>

            <!-- Date de création -->

            <p id="profile_creation" class="mt-4 text-sm text-white/70 text-center break-words"></p>

        </div>

        <!-- Historique / recherche -->

        <div class="w-full max-w-md min-w-0 flex flex-col items-center gap-4">

            <!-- Search barre -->

            <div id="search_container" class="flex w-full items-center justify-center gap-2 sm:gap-3">

                <input id="search_player_in" type="text" placeholder="" class="p-3 rounded-lg min-w-0 flex-1 w-0 bg-gray-800 text-white placeholder-gray-400 outline-none focus:ring-2 focus:ring-purple-400" />

                <button id="search_player_btn" class="shrink-0 py-3 px-3 sm:px-4 bg-gradient-to-r from-teal-500 to-lime-500 text-white rounded-lg hover:scale-105 transition-all duration-300">🔎</button>

            </div>

            <!-- Historique -->

            <div id="histo" class="w-full min-w-0 rounded-xl bg-black/30 p-4 sm:p-5 text-white shadow-lg">

                <p id="histo_text" class="text-lg font-semibold mb-4">Historique</p>

                <svg id="wr_graph" viewBox="0 0 36 36" class="mx-auto mb-4 w-32 h-32 max-w-full" style="max-height: 120px;">

                    <path class="around" style="stroke: #960e0e; fill: none; stroke-width: 2.8;" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>

                    <path id="percent" class="percent" style="stroke: #6f6fff; fill: none; stroke-width: 2.8; stroke-linecap: round;" stroke-dasharray="30, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>

                    <text id="wr" x="18" y="14" text-anchor="middle" dy="7" font-size="10">3/10</text>

                </svg>

                <ul id="histo_list" class="space-y-2 text-sm text-gray-300">

                </ul>

            </div>

        </div>

    </div>

</div>

<!-- FIN PROFILE -->

                <!--CREATION OF A TOURNAMENT-->

                <div id="tournament_form" style="display: none">

                    <h3>Creating a tournament</h3>

                    <form>

                        <label>Tournament's name</label>

                        <input type="text" name="tname" id="tournament_name"/>

                        <input type="submit" value="Submit" id="tournament_creation"/>

                    </form>

                </div>



                <!--LIST OF TOURNAMENTS-->

                <div id="tournaments_join" style="display: none;">

                    <h3>Tournaments</h3>

                    <search id="tournaments_list">

                    </search>

                </div>



                <!-- Tournament home's page -->

                <div id="tournament" style="display: none;">

                    <h3>Tournament's name</h3>

                    <table>

                        <tr>

                            <th>User</th>

                            <th>   </th>

                        </tr>

                    </table>

                    <button>Start</button>

                    <button>Leave</button>

                </div>

            <!-- Friendlist box -->

            <div class="fixed bottom-3 left-3 right-3 z-30 rounded-xl border border-white/20 bg-black/30 p-3 text-white shadow-lg backdrop-blur-md sm:bottom-4 sm:left-auto sm:right-4 sm:w-72">

                <h2 id="friend_text" class="mb-2 text-lg font-bold">Amis connectés</h2>

                <div id="friendlist" class="max-h-48 space-y-2 overflow-y-auto"></div>

                </div>

        </div> 

    <!-- JEU -->

    <div
        id="game_box"
        class="hidden w-full min-h-0 flex-col items-center justify-center px-2 sm:px-4"
    >
        <!-- SCOREBOARD au-dessus -->

        <div id="scoreboard"
            class="flex w-full flex-wrap items-center justify-center gap-2 sm:gap-3 text-center min-w-0">            <span id="player-left"
                class="px-3 py-2 sm:px-4 sm:py-2 md:px-5 md:py-3 text-base sm:text-lg md:text-xl lg:text-2xl font-extrabold text-white bg-gradient-to-r from-fuchsia-500 via-red-500 to-orange-400 rounded-lg border-2 border-white shadow-lg text-center tracking-wide select-none max-w-[35vw] truncate">
                Player 1
            </span>

            <span id="score-left"
                class="px-3 py-2 sm:px-4 sm:py-2 md:px-5 md:py-3 text-lg sm:text-xl md:text-2xl lg:text-3xl font-extrabold text-white bg-gradient-to-r from-fuchsia-500 via-red-500 to-orange-400 rounded-lg border-2 border-white shadow-lg text-center select-none">
                0
            </span>

            <span id="score-right"
                class="px-3 py-2 sm:px-4 sm:py-2 md:px-5 md:py-3 text-lg sm:text-xl md:text-2xl lg:text-3xl font-extrabold text-white bg-gradient-to-r from-emerald-400 via-teal-400 to-lime-400 rounded-lg border-2 border-white shadow-lg text-center select-none">
                0
            </span>

            <span id="player-right"
                class="px-3 py-2 sm:px-4 sm:py-2 md:px-5 md:py-3 text-base sm:text-lg md:text-xl lg:text-2xl font-extrabold text-white bg-gradient-to-r from-emerald-400 via-teal-400 to-lime-400 rounded-lg border-2 border-white shadow-lg text-center tracking-wide select-none max-w-[35vw] truncate">
                Player 2
            </span>
        </div>



        <!-- CANVAS -->

        <canvas
            id="pong"
            width="720"
            height="520"
            class="block w-full max-w-[720px] h-auto mx-auto"
            autofocus>
        </canvas>
    </div>

    <div id="about" class="hidden whitespace-pre-line text-white font-bold flex-col items-center justify-center px-3 w-full md:w-3/4 mx-auto bg-gradient-to-br from-green-400 via-cyan-500 to-blue-500 p-5 sm:p-6 rounded-xl shadow-lg transform transition-all duration-300 hover:scale-105 hover:shadow-xl break-words overflow-hidden">    



