<!-- Popup pour le changement de mot de passe -->
<div id="passwordPopup" class="fixed inset-0 flex items-center justify-center hidden z-50">
    <div class="bg-gray-800 p-6 rounded-lg w-96 shadow-lg">
        <h3 id="pass_change" class="text-xl font-semibold mb-4 text-teal-400 text-center">Changer le mot de passe</h3>
        
        <!-- Formulaire pour changer le mot de passe -->
        <form id="passwordForm">
            <div class="mb-4">
                <label id="pass_current" for="currentPassword" class="block text-sm font-medium text-white">Mot de passe actuel</label>
                <input type="password" id="currentPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label id="pass_new" for="newPassword" class="block text-sm font-medium text-white">Nouveau mot de passe</label>
                <input type="password" id="newPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label id="pass_confirm" for="confirmPassword" class="block text-sm font-medium text-white">Confirmer le nouveau mot de passe</label>
                <input type="password" id="confirmPassword" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <!-- Messages d'erreur -->
            <div id="errorMessages" class="text-red-500 mb-4 hidden">
                <p id="errorMessageText"></p>
            </div>

            <div class="flex justify-between items-center">
                <button id="cancel" type="button" class="bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400" onclick="closePasswordPopup()">Annuler</button>
                <button id="confirm" type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-700">Valider</button>
            </div>
        </form>
    </div>
</div>



